# Copy this file to .env and fill in real values before running
# `docker compose up`. Docker Compose automatically reads a .env file
# in the same directory, so these become available to the ${VAR:-default}
# references in docker-compose.yml.

# --- Security ---
# Generate a long random string, e.g.: openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_random_secret_in_prod

# --- Razorpay (test-mode keys, free) ---
# https://dashboard.razorpay.com -> toggle "Test Mode" -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Google Sign-In ---
# https://console.cloud.google.com -> APIs & Services -> Credentials ->
# Create OAuth client ID -> Web application. Add your frontend URL
# (e.g. http://localhost:5173) under "Authorized JavaScript origins".
# Only the client ID is used - see application.yml's comment on why the
# client SECRET is never needed by this backend at all.
GOOGLE_CLIENT_ID=

# --- Email (real SMTP delivery for OTP codes + booking confirmations) ---
# For Gmail: Google Account -> Security -> 2-Step Verification -> App
# Passwords -> generate one for "Mail". MAIL_PASSWORD is that 16-character
# App Password, NOT your actual Gmail account password (Gmail rejects SMTP
# login with a real password once 2FA is on).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- URLs ---
# FRONTEND_URL is used by the backend for CORS.
# VITE_API_URL / VITE_WS_URL are baked into the frontend's build (Vite env
# vars are compile-time) - they must point to wherever a BROWSER can reach
# the backend, not the internal Docker network hostname.
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080/ws


# Web3Forms access key for the footer "Send Feedback" drawer (FeedbackDrawer.jsx).
# Get one free at https://web3forms.com - it's meant to be used client-side.
VITE_WEB3FORMS_ACCESS_KEY=
